---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle != blank %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article class="about-article">
    <!-- Bio section -->
    <section id="about" class="about-section about-section--bio">
      {% if page.profile %}
        <div class="profile profile-about {% if page.profile.style_class %}{{ page.profile.style_class }} {% endif %}float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% assign profile_image_alt = page.profile.image_alt | default: page.profile.image %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.27}}px, (min-width: 576px) 27vw, 95vw"{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_image_alt
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
          {% if page.social_in_profile %}
            <div class="about-social-icons about-social-icons--profile">
              {% social_links %}
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="clearfix bio-content">{{ content }}</div>
    </section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section id="news" class="about-section about-section--news">
        <div class="about-section-heading">
          <h2 class="about-section-title">News</h2>
          <button type="button" class="section-link news-toggle" hidden>View all <span aria-hidden="true">→</span></button>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section id="publications" class="about-section about-section--publications">
        <h2 class="about-section-title">Selected Publications</h2>
        <p class="post-description">* indicates equal contribution.</p>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        {% if site.contact_note != blank %}
          <div class="contact-note">{{ site.contact_note }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var extras = document.querySelectorAll('.about-section--news .news-extra');
    var toggle = document.querySelector('.news-toggle');
    if (!toggle || extras.length === 0) {
      return;
    }
    toggle.hidden = false;
    toggle.addEventListener('click', function () {
      extras.forEach(function (row) {
        row.classList.remove('news-extra');
      });
      toggle.hidden = true;
    });
  });
</script>
