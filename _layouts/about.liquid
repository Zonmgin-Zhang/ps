---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle != blank %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article class="about-article">
    <!-- Bio section -->
    <section class="about-section about-section--bio">
      {% if page.profile %}
        <div class="profile profile-about {% if page.profile.style_class %}{{ page.profile.style_class }} {% endif %}float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.15}}px, (min-width: 576px) 15vw, 95vw"{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
          {% if page.social_in_profile %}
            <div class="about-social-icons about-social-icons--profile">
              {% social_links %}
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="clearfix bio-content">{{ content }}</div>
      <!-- Subtle offshore line art for the bio card -->
      <svg class="section-doodle doodle-bio" aria-hidden="true" viewBox="0 0 148 92" xmlns="http://www.w3.org/2000/svg">
        <path class="accent" d="M7 72 C20 66, 33 78, 46 72 C59 66, 72 78, 85 72 C98 66, 111 78, 124 72 C132 68, 140 70, 145 73" fill="none"/>
        <path d="M24 54 C49 24, 86 13, 126 20" fill="none"/>
        <path class="fine" d="M126 20 C132 39, 121 50, 124 64" fill="none"/>
        <path class="accent-fill" d="M120 64 L128 64 L124 75 Z"/>
        <path d="M91 61 C99 54, 111 54, 120 62 C110 69, 99 69, 91 61 Z" fill="none"/>
        <path d="M91 61 L82 55 L82 68 Z" fill="none"/>
        <circle cx="112" cy="60" r="1.4" fill="currentColor"/>
      </svg>
    </section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="about-section about-section--news">
        <h2 class="about-section-title">News</h2>
        {% include news.liquid limit=true %}
        <!-- Compact lure and ripple motif for the news card -->
        <svg class="section-doodle doodle-news" aria-hidden="true" viewBox="0 0 128 86" xmlns="http://www.w3.org/2000/svg">
          <path class="accent" d="M12 68 C24 62, 36 74, 48 68 C60 62, 72 74, 84 68 C96 62, 108 74, 120 68" fill="none"/>
          <path d="M90 17 C101 20, 110 29, 112 41" fill="none"/>
          <path class="fine" d="M112 41 L112 54" fill="none"/>
          <path class="accent-fill" d="M107 54 L117 54 L112 68 Z"/>
          <circle class="accent-ring" cx="112" cy="68" r="9"/>
          <path d="M28 45 C37 37, 50 37, 59 45 C50 53, 37 53, 28 45 Z" fill="none"/>
          <path d="M28 45 L20 39 L20 51 Z" fill="none"/>
          <circle cx="51" cy="44" r="1.2" fill="currentColor"/>
        </svg>
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="about-section about-section--publications">
        <h2 class="about-section-title">Selected Publications</h2>
        <p class="post-description">* indicates equal contribution.</p>
        {% include selected_papers.liquid %}
        <!-- Refined catch silhouette for the publications card -->
        <svg class="section-doodle doodle-publications" aria-hidden="true" viewBox="0 0 132 88" xmlns="http://www.w3.org/2000/svg">
          <path class="accent" d="M12 72 C25 66, 38 78, 51 72 C64 66, 77 78, 90 72 C103 66, 116 78, 128 72" fill="none"/>
          <path d="M31 43 C45 29, 70 28, 88 43 C70 58, 45 58, 31 43 Z" fill="none"/>
          <path d="M31 43 L18 33 L18 54 Z" fill="none"/>
          <path class="fine" d="M53 32 C50 38, 50 48, 54 54" fill="none"/>
          <path class="fine" d="M77 33 C73 39, 73 48, 78 54" fill="none"/>
          <circle cx="77" cy="41" r="1.6" fill="currentColor"/>
          <path class="accent" d="M90 32 C101 23, 113 24, 121 33" fill="none"/>
          <path class="accent" d="M91 54 C103 62, 115 60, 123 50" fill="none"/>
        </svg>
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        {% if site.contact_note != blank %}
          <div class="contact-note">{{ site.contact_note }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
